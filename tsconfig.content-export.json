{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": ".content-build",
    "rootDir": "src",
    "ignoreDeprecations": "6.0",
    "strict": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/data/curriculum.ts", "src/data/courseExpansions.ts", "src/types.ts"]
}
